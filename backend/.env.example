# CogniFleet backend environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Security (REQUIRED in production) -------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Set to "production" to enforce SECRET_KEY and disable demo seeding/CORS "*".
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///./fleet.db

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo data --------------------------------------------------------------
# Seed demo accounts (admin/admin, driver1/driver) when the database is empty.
SEED_DEMO_DATA=true

# --- Optional AI ------------------------------------------------------------
OPENAI_API_KEY=
